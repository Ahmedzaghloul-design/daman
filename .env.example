# Copy this file to .env and fill in your values. Never commit .env.

# Get a key at https://aistudio.google.com/apikey
# (A Gemini app subscription does NOT include API access; the API key is separate.)
GEMINI_API_KEY=

# gemini-3.6-flash: stable, works on the free tier (tested Nov 2026).
# gemini-4-argon: Google's flagship, needs billing enabled (free-tier quota is 0).
# gemini-3.8-flash: newest flash, was overloaded/timing out when tested.
GEMINI_MODEL=gemini-3.6-flash

# Set to true to demo without an API key (returns rule-based parses of the sample receipts).
GEMINI_MOCK=false

API_PORT=8787

# Only set this once Gemini billing is on (paid tier). Until then real receipt
# photos are blocked, because Google may use free-tier content.
# GEMINI_BILLING=paid

# --- Server-only settings for WhatsApp (see docs/WHATSAPP.md). Never in the app or GitHub.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+1...
# WHATSAPP_WEBHOOK_URL=https://<api address>/api/whatsapp
# SUPABASE_URL=https://sovamqmyxkptfmswcknt.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# WHATSAPP_TEST_DATA=true

# --- Website build: its public address, for link previews and the sitemap.
# VITE_SITE_URL=https://your-domain
