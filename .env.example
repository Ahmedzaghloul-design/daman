# Copy this file to .env and fill in your values. Never commit .env.

# Get a key at https://aistudio.google.com/apikey
# (A Gemini app subscription does NOT include API access; the API key is separate.)
GEMINI_API_KEY=

# gemini-3.6-flash: stable, works on the free tier (tested Nov 2026).
# gemini-4-argon: Google's flagship, needs billing enabled (free-tier quota is 0).
# gemini-3.8-flash: newest flash, was overloaded/timing out when tested.
GEMINI_MODEL=gemini-3.6-flash

# Set to true to demo without an API key (returns rule-based parses of the sample receipts).
GEMINI_MOCK=false

API_PORT=8787
