{
  "name": "daman",
  "private": true,
  "version": "0.2.0",
  "description": "Daman (ضمان): analog-to-digital bridge for EU CBAM compliance",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "packages/*",
    "api",
    "app",
    "website"
  ],
  "scripts": {
    "dev": "concurrently -n api,app,web -c green,blue,magenta \"npm:dev:api\" \"npm:dev:app\" \"npm:dev:website\"",
    "dev:api": "npm run dev -w @daman/api",
    "dev:app": "npm run dev -w @daman/app",
    "dev:website": "npm run dev -w @daman/website",
    "build": "npm run build -w @daman/app && npm run build -w @daman/website",
    "test": "npm test -w @daman/core -w @daman/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
